# Supabase API Settings
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Cloudinary (Media CDN Storage for Exam Images & Audio)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Backend Keys (Never expose to browser)
GEMINI_API_KEY=your_gemini_api_key_here
API_KEY=your_gemini_api_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Static Assets CDN Offload (GitHub + jsDelivr) & Emergency Switch
# Set VITE_DISABLE_CDN=true in Vercel Environment Variables and Redeploy to serve all JS/CSS directly from Vercel.
VITE_DISABLE_CDN=false
# Optional: override "owner/repo" if Vercel git metadata env vars are not present
VITE_CDN_REPO=

# Turso Active Exam Polling & Encrypted Question Bundle Cache
# Server-only secrets (NEVER add VITE_ prefix to TURSO_AUTH_TOKEN or TURSO_EXAM_SECRET)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
TURSO_EXAM_SECRET=
# Browser-safe Read-Only Turso credentials for direct student polling
VITE_TURSO_DATABASE_URL=
VITE_TURSO_READ_TOKEN=

